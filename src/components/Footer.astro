---
// Pie en azul marino con columnas: marca y redes, zonas, servicios y contacto (todo desde site.yaml).
// Zonas y servicios salen de las secciones `zonas` y `servicios` (o de las que usen ese diseño con `tipo:`); si no hay, la columna no sale.
// «Web creada con NoExpertise» se muestra si site.yaml → marca_pie no es false.
import { site, tel, mapa, buscarSeccion } from '../data/site';
import Icono from './ui/Icono.astro';
interface Props { variante?: string }
const { variante = 'inmo' } = Astro.props;
const c = site.contacto;
const redes = Object.entries(site.redes).filter(([, url]) => url);
const anio = new Date().getFullYear();
const zonas = buscarSeccion('zonas');
const servicios = buscarSeccion('servicios');
const columnas = [
  zonas && { titulo: zonas.s.antetitulo || zonas.s.titulo || '', url: `/#${zonas.id}`, items: zonas.s.items.map((i) => i.titulo).filter(Boolean).slice(0, 8) },
  servicios && { titulo: servicios.s.antetitulo || servicios.s.titulo || '', url: `/#${servicios.id}`, items: servicios.s.items.map((i) => i.titulo).filter(Boolean).slice(0, 8) },
].filter((col) => col && col.items.length > 0) as { titulo: string; url: string; items: string[] }[];
---

<footer class={`pie pie--${variante}`}>
  <div class="contenedor pie-rejilla">
    <div class="pie-marca">
      <p class="pie-nombre">{site.nombre}</p>
      {site.eslogan && <p class="pie-eslogan">{site.eslogan}</p>}
      {
        redes.length > 0 && (
          <ul class="pie-redes">
            {redes.map(([red, url]) => (
              <li>
                <a href={url} rel="noopener" target="_blank" aria-label={red}>
                  <Icono nombre={red} tam={20} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    {
      columnas.map((col) => (
        <div>
          {col.titulo && <p class="pie-titulo">{col.titulo}</p>}
          <ul class="pie-lista">
            {col.items.map((t) => <li><a href={col.url}>{t}</a></li>)}
          </ul>
        </div>
      ))
    }
    <div>
      <p class="pie-titulo">Contacto</p>
      <ul class="pie-lista">
        {c.telefono && <li><a href={tel(c.telefono)} class="text-lg font-bold text-white">{c.telefono}</a></li>}
        {c.email && <li><a href={`mailto:${c.email}`}>{c.email}</a></li>}
        {c.direccion && <li><a href={mapa(c.direccion)} rel="noopener" target="_blank">{c.direccion}</a></li>}
        {c.horario && <li class="text-sm opacity-80">{c.horario}</li>}
      </ul>
    </div>
  </div>
  <div class="contenedor pie-legal">
    <span>© {anio} {site.nombre}</span>
    <a href="/aviso-legal">Aviso legal y privacidad</a>
    {
      site.marca_pie && (
        <span class="pie-noexpertise">
          Web creada con <a href="https://noexpertise.com" rel="noopener">NoExpertise</a>
        </span>
      )
    }
  </div>
</footer>
