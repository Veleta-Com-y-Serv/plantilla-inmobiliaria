---
// Hero: foto a todo el ancho con velo marino a la izquierda, texto alineado a la izquierda y,
// a la derecha (debajo en móvil), una tarjeta flotante con los accesos (items: titulo, texto, icono, url).
import { seccion } from '../../data/site';
import { altHero } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string; primera?: boolean }
const { id, primera = false } = Astro.props;
const s = seccion(id);
const accesos = s ? s.items.filter((i) => i.titulo) : [];
---

{
  s && (
    <section id={id} class="hero-inmo fondo-oscuro relative isolate overflow-hidden bg-primario text-white">
      {s.imagen && (
        <Imagen src={s.imagen} alt={altHero()} ancho={1920} alto={1080} prioridad={primera} respaldo="/placeholders/hero.svg" class="absolute inset-0 -z-10 h-full w-full object-cover" />
      )}
      <div class="hero-inmo-velo absolute inset-0 -z-10" aria-hidden="true" />
      <div class:list={['contenedor grid items-center gap-10 py-14 md:py-20 lg:min-h-[38rem] lg:py-24', accesos.length > 0 && 'lg:grid-cols-12']}>
        <div class="lg:col-span-7">
          {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
          {s.titulo && <h1 class="mt-4 max-w-2xl text-[clamp(2.1rem,5.4vw,3.6rem)] text-white">{s.titulo}</h1>}
          {s.texto && <p class="mt-5 max-w-xl text-lg text-white/85">{s.texto}</p>}
          {(s.cta?.url || s.cta_secundario?.url) && (
            <div class="mt-8 flex flex-wrap gap-3">
              {s.cta?.url && <a class="btn-oro" href={s.cta.url}>{s.cta.texto}</a>}
              {s.cta_secundario?.url && <a class="btn-sec text-white" href={s.cta_secundario.url}>{s.cta_secundario.texto}</a>}
            </div>
          )}
        </div>
        {accesos.length > 0 && (
          <nav class="lg:col-span-5 lg:col-start-8" aria-label={s.titulo || undefined}>
            <ul class="hero-inmo-tarjeta overflow-hidden rounded-[var(--radio)] bg-white text-texto">
              {accesos.map((a) => {
                const Etiqueta = a.url ? 'a' : 'div';
                return (
                  <li class="border-b border-texto/10 last:border-b-0">
                    <Etiqueta href={a.url || undefined} class="group flex items-center gap-4 px-5 py-4 no-underline transition-colors hover:bg-primario/5 sm:px-6 sm:py-5">
                      <span class="icono-cuadro"><Icono nombre={a.icono || 'casa'} tam={22} /></span>
                      <span class="min-w-0 flex-1">
                        <span class="block text-lg font-bold text-primario">{a.titulo}</span>
                        {a.texto && <span class="block text-sm opacity-75">{a.texto}</span>}
                      </span>
                      {a.url && <Icono nombre="flecha" tam={20} class="shrink-0 text-[var(--c-acento-texto)] transition-transform group-hover:translate-x-1" />}
                    </Etiqueta>
                  </li>
                );
              })}
            </ul>
          </nav>
        )}
      </div>
    </section>
  )
}

<style>
  .hero-inmo-velo {
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--c-primario) 55%, transparent), color-mix(in srgb, var(--c-primario) 88%, transparent));
  }
  @media (min-width: 1024px) {
    .hero-inmo-velo {
      background: linear-gradient(90deg, color-mix(in srgb, var(--c-primario) 94%, transparent) 0%, color-mix(in srgb, var(--c-primario) 72%, transparent) 48%, color-mix(in srgb, var(--c-primario) 20%, transparent) 100%);
    }
  }
  .hero-inmo-tarjeta { box-shadow: 0 24px 48px -16px rgb(0 0 0 / .45); border-top: 4px solid var(--c-acento); }
</style>
