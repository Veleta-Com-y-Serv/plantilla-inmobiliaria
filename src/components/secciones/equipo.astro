---
// Equipo: fichas horizontales (foto cuadrada + nombre, cargo y texto) en dos columnas.
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const personas = s ? s.personas.filter((p) => p.nombre) : [];
---

{
  s && (
    <Seccion id={Astro.props.id}>
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      {personas.length > 0 && (
        <ul class="grid gap-5 md:grid-cols-2">
          {personas.map((p) => (
            <li class="ficha flex items-center gap-5 p-4 sm:p-5">
              <Imagen src={p.foto || '/placeholders/persona.svg'} alt={`Retrato de ${p.nombre}`} ancho={240} alto={240} respaldo="/placeholders/persona.svg" class="h-20 w-20 shrink-0 rounded-[var(--radio)] bg-[var(--c-suave)] object-cover sm:h-28 sm:w-28" />
              <div class="min-w-0">
                <p class="text-lg font-bold text-primario">{p.nombre}</p>
                {p.cargo && <p class="text-xs font-bold uppercase tracking-[.12em] text-[var(--c-acento-texto)]">{p.cargo}</p>}
                {p.texto && <p class="mt-2 text-sm opacity-80">{p.texto}</p>}
              </div>
            </li>
          ))}
        </ul>
      )}
    </Seccion>
  )
}
